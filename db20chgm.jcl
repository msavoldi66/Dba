//P060DUD EXEC DB20DUD,
//    DESC='DB2: ANOMALIA STEP P060IMP - PROC DB20CHGM ',
//    RTC='04',
//    OPE='<',
//    STEP='',
//    MAIL='NO',
//    CEN=&CEN,
//    MAILB=MDB2
// ENDIF
//*
//* FASE DI ANALYZE
//*
//P070ANA  EXEC PGM=ALUAMAIN,
//        REGION=0M,
//        PARM='&DB2ARR.OPD1'
//STEPLIB DD  DSN=Y&CENN.00BMC.PE000.CHGMAN.UBMCLINK,DISP=SHR
//        DD  DSN=Y&CENN.00BMC.PE000.CHGMAN.BMCLINK,DISP=SHR
//        DD  DSN=L&CEN.P00.SYSTEM.PRM.DB2,DISP=SHR
//        DD  DSN=Y&CENN.00DB2.PE000.&DB2ARR..DSNEXIT,DISP=SHR
//        DD  DSN=Y&CENN.00DB2.PE000.&DB2ARR..DSNLOAD,DISP=SHR
//SYSPROC  DD DSN=Y&CENN.00BMC.PE000.CHGMAN.UBMCCLIB,DISP=SHR
//         DD DSN=Y&CENN.00BMC.PE000.CHGMAN.BMCCLIB,DISP=SHR
//ABNLIGNR DD DUMMY
//SYSUDUMP DD SYSOUT=*
//ALUPRINT DD SYSOUT=*
//SYSTSPRT DD SYSOUT=*
//AJXPOFVL DD DUMMY
//ALUIN    DD DISP=SHR,
//   DSN=X&CENN.00DB2.TW000.U&ID2..&DBNAME..&DB2ARR..SKANA
//AJXPOFIN DD DISP=SHR,
//   DSN=X&CENN.00DB2.TW000.U&ID2..&DBNAME..&DB2ARR..SKPOF
//WORKL001 DD DSN=X&CENN.00DB2.TW000.U&ID2..&DBNAME..&DB2ARR..WKL,
//   DISP=SHR
//*
// IF (P070ANA.RC GT 4) THEN
//P070DUD EXEC DB20DUD,
//    DESC='DB2: ANOMALIA STEP P070ANA - PROC DB20CHGM ',
//    RTC='04',
//    OPE='<',
//    STEP='',
//    MAIL='NO',
//    CEN=&CEN,
//    MAILB=MDB2
//* CANCELLO WORKLIST IN CASO DI ABEND
//*P070DEL EXEC PGM=IEFBR14
//*WORKL001 DD DSN=X&CENN.00DB2.TW000.U&ID2..&DBNAME..&DB2ARR..WKL,
//*   DISP=SHR
// ENDIF
//*
//*
//* PASSI DI GENERAZIONE JOB DI EXECUTE (SE TUTTO OK)
//*
//P080PRF EXEC PGM=IEBCOPY
//ISPMLIB DD DSN=Y&CENN.00BMC.PE000.CHGMAN.BMCTLIB,DISP=SHR
//OUT      DD SPACE=(TRK,(2,1,3)),DISP=(NEW,PASS),
//            DSN=&&TPRF1
//SYSPRINT DD DUMMY
//SYSIN    DD DISP=SHR,DSN=L&CEN.P00.SYSTEM.INPUT&TESTLIB(DB2UDCXI)
//*
// IF (P080PRF.RC GT 4) THEN
//P080DUD EXEC DB20DUD,
//    DESC='DB2: ANOMALIA STEP P080PRF - PROC DB20CHGM ',
//    RTC='04',
//    OPE='<',
//    STEP='',
//    MAIL='NO',
//    CEN=&CEN,
//    MAILB=MDB2
// ENDIF
//*
//P090IEB EXEC PGM=IEBGENER
//SYSUT2   DD SPACE=(TRK,(1,1)),DISP=(NEW,PASS),
//    DSN=&&TSIN1,
//            DSORG=PS,LRECL=80,BLKSIZE=3200,RECFM=FB
//SYSIN    DD DUMMY
//SYSPRINT DD DUMMY
//SYSUT1   DD *
//*
//* GENERAZIONE JCL DI EXEC
//*
//P100GEN EXEC PGM=AJXBMAIN,
//     REGION=0M,PARM='&DB2ARR.OPD1'
//STEPLIB DD  DSN=Y&CENN.00BMC.PE000.CHGMAN.UBMCLINK,DISP=SHR
//        DD  DSN=Y&CENN.00BMC.PE000.CHGMAN.BMCLINK,DISP=SHR
//        DD  DSN=L&CEN.P00.SYSTEM.PRM.DB2,DISP=SHR
//        DD  DSN=Y&CENN.00DB2.PE000.&DB2ARR..DSNEXIT,DISP=SHR
//        DD  DSN=Y&CENN.00DB2.PE000.&DB2ARR..DSNLOAD,DISP=SHR
//ABNLIGNR DD DUMMY
//AJXERR   DD SYSOUT=*
//ISPPROF  DD DSN=&&TPRF1,DISP=(OLD,PASS)
//SYSPROC  DD DSN=Y&CENN.00BMC.PE000.CHGMAN.UBMCCLIB,DISP=SHR
//         DD DSN=Y&CENN.00BMC.PE000.CHGMAN.BMCCLIB,DISP=SHR
//ACT$MSGS DD DSN=Y&CENN.00BMC.PE000.CHGMAN.UBMCMLIB,DISP=SHR           SHR
//         DD DSN=Y&CENN.00BMC.PE000.CHGMAN.BMCMLIB,DISP=SHR
//ISPMLIB  DD DSN=Y&CENN.00BMC.PE000.CHGMAN.UBMCMLIB,DISP=SHR           SHR
//         DD DSN=Y&CENN.00BMC.PE000.CHGMAN.BMCMLIB,DISP=SHR
//         DD DSN=SYS1.SISPMENU,DISP=SHR
//ISPSLIB  DD DSN=Y&CENN.00BMC.PE000.CHGMAN.UBMCSLIB,DISP=SHR
//         DD DSN=Y&CENN.00BMC.PE000.CHGMAN.BMCSLIB,DISP=SHR
//ISPTLIB  DD DSN=Y&CENN.00BMC.PE000.CHGMAN.UBMCTLIB,DISP=SHR
//         DD DSN=Y&CENN.00BMC.PE000.CHGMAN.BMCTLIB,DISP=SHR
//ISPPLIB  DD DSN=Y&CENN.00BMC.PE000.CHGMAN.UBMCPLIB,DISP=SHR
//         DD DSN=Y&CENN.00BMC.PE000.CHGMAN.BMCPLIB,DISP=SHR
//ISPCTL0  DD SPACE=(CYL,(5,5)),UNIT=SYSALLDA,DISP=(,PASS),
//         DCB=(LRECL=80,BLKSIZE=800,RECFM=FB)
//ISPCTL1  DD SPACE=(CYL,(5,5)),UNIT=SYSALLDA,DISP=(,PASS),
//         DCB=(LRECL=80,BLKSIZE=800,RECFM=FB)
//ISPCTL2  DD SPACE=(CYL,(5,5)),UNIT=SYSALLDA,DISP=(,PASS),
//         DCB=(LRECL=80,BLKSIZE=800,RECFM=FB)
//ISPCTL3  DD SPACE=(CYL,(5,5)),UNIT=SYSALLDA,DISP=(,PASS),
//         DCB=(LRECL=80,BLKSIZE=800,RECFM=FB)
//ISPWRK1  DD SPACE=(CYL,(5,5)),UNIT=SYSALLDA,DISP=(,PASS),
//         DCB=(LRECL=256,BLKSIZE=2560,RECFM=FB)
//ISPWRK2  DD SPACE=(CYL,(5,5)),UNIT=SYSALLDA,DISP=(,PASS),
//         DCB=(LRECL=256,BLKSIZE=2560,RECFM=FB)
//ISPWRK3  DD SPACE=(CYL,(5,5)),UNIT=SYSALLDA,DISP=(,PASS),
//         DCB=(LRECL=256,BLKSIZE=2560,RECFM=FB)
//ISPCNTL  DD SPACE=(CYL,(5,5)),UNIT=SYSALLDA,DISP=(,PASS),
//         DCB=(LRECL=80,BLKSIZE=800,RECFM=FB)
//SYSTSIN  DD SPACE=(TRK,(1,1)),DISP=(OLD,PASS),
//            DSN=&&TSIN1,
//            DSORG=PS,LRECL=80,BLKSIZE=3200,RECFM=FB
//ISPLOG   DD SYSOUT=*,
//         DSORG=PS,LRECL=125,BLKSIZE=129,RECFM=VA
//SYSTSPRT DD SYSOUT=*,
//            DSORG=PS,LRECL=137,BLKSIZE=3155,RECFM=VBA
//AJXPRINT DD SYSOUT=*
//SYSTERM  DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//AJXJCL   DD DISP=SHR,
// DSN=X&CENN.00DB2.TW000.U&ID2..&DBNAME..&DB2ARR(EXEC)
//WORKLIST DD DISP=SHR,
//  DSN=X&CENN.00DB2.TW000.U&ID2..&DBNAME..&DB2ARR..WKL
//AJXIN  DD DISP=SHR,
//   DSN=X&CENN.00DB2.TW000.U&ID2..&DBNAME..&DB2ARR..SKE1
//AJXPOFIN DD DISP=SHR,
//   DSN=X&CENN.00DB2.TW000.U&ID2..&DBNAME..&DB2ARR..SKE2
//*
