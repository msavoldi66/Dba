//ABNLIGNR DD DUMMY
//ALUPRINT DD SYSOUT=*
//SYSTERM  DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//IMPORTIN DD DISP=SHR,
//    DSN=X&CENN.00DB2.TW000.U&ID2..&DBNAME..&DB2ARR(CDLBL)
//ALUIN    DD DISP=SHR,
//       DSN=X&CENN.00DB2.TW000.U&ID2..&DBNAME..&DB2ARR..SKIMP
//*
