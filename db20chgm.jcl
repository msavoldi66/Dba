//*
//* CANCELLAZIONE WKLIST
//*
//P120DEL   EXEC PGM=IDCAMS
//SYSPRINT  DD SYSOUT=*
//SYSIN     DD *,SYMBOLS=(JCLONLY,REPDD)
 DELETE X&CENN.00DB2.TW000.U&ID2..&DBNAME..&DB2ARR..SKANA
 DELETE X&CENN.00DB2.TW000.U&ID2..&DBNAME..&DB2ARR..SKE1
 DELETE X&CENN.00DB2.TW000.U&ID2..&DBNAME..&DB2ARR..SKE2
 DELETE X&CENN.00DB2.TW000.U&ID2..&DBNAME..&DB2ARR..SKIMP
 DELETE X&CENN.00DB2.TW000.U&ID2..&DBNAME..&DB2ARR..SKPOF
 SET MAXCC = 0
