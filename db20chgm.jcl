//*
// IF (&EXECJOB=1) THEN
//*
//*
//* LANCIO JOB DI EXECUTE SUL DB2 DI ARRIVO
//*
//P110EXE EXEC DB20JOBS,CEN=&CEN,SUB=YES,DESC=MS4,AMB=ALL,MSGCLASS=Y,
//     CHIUSI=NO,MON=YES,DUD=YES,MAIL=ALL,MAILB=MDB2,
// MAILTXT='ANOMALIA-STEP-P110EXE-DB20JOBS',FILTRO=CEN(*ALL*),
// TESTLIB=&TESTLIB
//INCLUDE DD *,SYMBOLS=(JCLONLY,REPDD)
&DB2ARR
//INPEXEC DD DISP=SHR,
//        DSN=X&CENN.00DB2.TW000.U&ID2..&DBNAME..&DB2ARR(EXEC)
//        DD DSN=L&CEN.P00.SYSTEM.INPUT&TESTLIB(SKDUDDB2),DISP=SHR
//REPDD DD SYSOUT=*
//*
