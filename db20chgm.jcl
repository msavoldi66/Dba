//P050CMP EXEC PGM=ACMCMAN,
//    REGION=0M,PARM='&DB2ARR.OPD1',
//    COND=(4,LT)
//STEPLIB DD  DSN=Y&CENN.00BMC.PE000.CHGMAN.UBMCLINK,DISP=SHR
//        DD  DSN=Y&CENN.00BMC.PE000.CHGMAN.BMCLINK,DISP=SHR
//        DD  DSN=L&CEN.P00.SYSTEM.PRM.DB2,DISP=SHR
//        DD  DSN=Y&CENN.00DB2.PE000.&DB2ARR..DSNEXIT,DISP=SHR
//        DD  DSN=Y&CENN.00DB2.PE000.&DB2ARR..DSNLOAD,DISP=SHR
//ABNLIGNR DD DUMMY
//ALUPRINT DD SYSOUT=*
//SYSTERM  DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//ALUIN    DD DISP=SHR,
//       DSN=X&CENN.00DB2.TW000.U&ID2..&DBNAME..&DB2ARR..SKCMP
//CDL001   DD DISP=SHR,
//      DSN=X&CENN.00DB2.TW000.U&ID2..&DBNAME..&DB2ARR(CDLBL)
//*
// IF (P050CMP.RC GT 4) THEN
//P050DUD EXEC DB20DUD,
//    DESC='DB2: ANOMALIA STEP P050CMP - PROC DB20CHGM ',
//    RTC='04',
//    OPE='<',
//    STEP='',
//    MAIL='NO',
//    CEN=&CEN,
//    MAILB=MDB2
// ENDIF
//*
//* VERIFICA SE CI SONO DIFFERENZE
