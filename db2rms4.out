       44 //PDUD EXEC DB20DUD,
          //    DESC='DB2: ANOMALIA STEP',
          //    RTC='04',
          //    OPE='<',
          //    STEP='',
          //    MAIL='NO',
          //    CEN=&CEN,
          //    MAILB=MDB2
          XX*****************************************************************     00171004
          XX* IN CASO DI ANOMALIA AD UNO STEP PRECEDENTE GESTISCE L'INVIO DI      00171104
          XX* UNA EVENTUALE MAIL E/O PERMETTE DI CAUSARE L'ABEND DEL JOB PER      00171104
          XX* BLOCCARNE L'ESECUZIONE.                                             00171104
          XX* VIENE USATA NELLE PROCEDURE DB20* SU TARGET E SU AMVS.              00171104
          XX*                                                                     00171104
          XX* SI COMPONE DI UN SOLO STEP CHE ESEGUE IL PGM ASSEMBLER Y200650      00171104
          XX* CHE RICHIAMA IL PROGRAMMA REXX Y6DUD PASSANDO TUTTI I PARAMETRI     00171104
          XX*                                                                     00171104
          XX* IL DOPPIO PASSAGGIO (PROGRAMMA ASSEMBLER + PROGRAMMA REXX) }        00171104
          XX* L'UNICO MODO PER POTER CAUSARE DIRETTAMENTE L'ABEND DELLO STEP      00171104
          XX* NEL CASO VENGA RICHIESTO.                                           00171104
          XX*                                                                     00171104
          XX* INPUT:                                                              00171104
          XX*  FILEIN= CONTIENE L'EVENTUALE TESTO DELLA MAIL CHE SI PUO'          00171104
          XX*          QUINDI PASSARE IN OVERRIDE (DEFAULT DUMMY)                 00171104
          XX*                                                                     00171104
          XX* PARAMETRI:                                                          00171321
          XX*   DESC = DESCRIZIONE DELL'ABEND CHE VERRA' RIPORTATA NELLA MAIL     00171321
          XX*   DESC2= DESCRIZIONE AGGIUNTIVA                                     00171321
          XX*   STEP = STEP DA CONTROLLARE (DEFAULT OGNI STEP PRECEDENTE)         00171321
          XX*   OPE  = OPERATORE UTILIZZATO PER IL TEST (ES. = > < >=)            00171321
          XX*   RTC  = RETURN CODE DA CONTROLLARE (IF RTC OPE STEP THEN .DUMP)    00171321
          XX*   MAIL =  NO  -> SOLO ABEND DEL JOB (DEFAULT)                       00171321
          XX*           YES -> SOLO MAIL SENZA ABEND DEL JOB                      00171321
          XX*           ALL -> MAIL E ABEND DEL JOB                               00171321
          XX*   MAILB= MEMBRO DI INPUT CONTENENTE GLI INDIRIZZI                   00171321
          XX*   DB2  = OPZIONALE, SE SPECIFICATO AGGIORNA IL TIMESTAMP DI FINE    00171321
          XX*           SULLA TABELLA AYY2.LOG_UTILITY PER IL JOB CORRENTE        00171321
          XX*           UTILIZZATO PRINCIPALMENTE PER LA PROCEDURA DB20LOAD       00171321
          XX*   ULTIMO= Y -> CONSIDERA SOLO L'ULTIMO STEP                         00171321
          XX*           N -> CONSIDERA TUTTI GLI STEP PRECEDENTI (DEFAULT)        00171321
          XX*                                                                     00171321
          XX* 21.04.23: DOCUMENTAZIONE SPOSTATA NEL JCL                           00171321
          XX*                                                                     00171321
          XX*****************************************************************     00174004
          IEFC653I SUBSTITUTION JCL - DB20DUD,DESC='DB2: ANOMALIA STEP',RTC='04',OPE='<',STEP='',MAIL='NO',CEN=C,
          MAILB=MDB2
       45 XXDB20DUD PROC DESC='JOBS DI MANUTENZIONE DB2',CEN=,
          XX       DESC2='',
          XX       AMBL='P',
          XX       RTC='00',
          XX       OPE='=',
          XX       STEP='',
          XX       DB2='',
          XX       CHIAVE='',
          XX       MAIL='NO',
          XX       ULTIMO='NO',
          XX       MAILB=MDB1
          XX* EXPORT DEI SIMBOLI DA UTILIZZARE NEGLI INPUT IN STREAM
       46 XXP000EXP  EXPORT SYMLIST=(RTC,STEP,MAIL,DB2,
          XX         CHIAVE,ULTIMO)
       47 XXP000SET  SET RTC=&RTC,STEP=&STEP,MAIL=&MAIL,DB2=&DB2,
          XX         CHIAVE=&CHIAVE,ULTIMO=&ULTIMO
          IEFC653I SUBSTITUTION JCL - RTC=04,STEP=,MAIL=NO,DB2=,CHIAVE=,ULTIMO=NO
       48 XXRTC      EXPORT EXPSET=04                          GENERATED STATEMENT
       49 XXSTEP     EXPORT EXPSET=                            GENERATED STATEMENT
       50 XXMAIL     EXPORT EXPSET=NO                          GENERATED STATEMENT
       51 XXDB2      EXPORT EXPSET=                            GENERATED STATEMENT
       52 XXCHIAVE   EXPORT EXPSET=                            GENERATED STATEMENT
       53 XXULTIMO   EXPORT EXPSET=NO                          GENERATED STATEMENT
       54 XXP0       EXEC PGM=Y200650,
          XX PARM=('Y6DUD OPER(&OPE) DESC1(&DESC)',
          XX   'DESC2(&DESC2)')
